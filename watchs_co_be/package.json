{
  "name": "watchs_co_be",
  "version": "1.0.0",
  "description": "watch sales website",
  "main": "server.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "migrate": "db-migrate up --env dev --config database.json --migrations-dir migrations_supabase",
    "migrate:supabase": "db-migrate up --env supabase --config database.json --migrations-dir migrations_supabase",
    "migrate:supabase:check": "db-migrate up --check --env supabase --config database.json --migrations-dir migrations_supabase",
    "rollback": "db-migrate down --env dev --config database.json --migrations-dir migrations_supabase",
    "maintenance": "node scripts/maintenance.js",
    "dev": "nodemon",
    "start": "node server.js",
    "email:test": "node scripts/sendTestEmail.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "db-migrate": "^0.11.14",
    "db-migrate-pg": "^1.5.2",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "fast-csv": "^5.0.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "10.2.1",
    "nodemon": "^3.1.11",
    "otplib": "^12.0.1",
    "pg": "^8.15.6",
    "stripe": "^14.0.0",
    "winston": "^3.19.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "<rootDir>/tests/environment.js",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/migrations/",
      "/tests/"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "models/**/*.js",
      "middleware/**/*.js",
      "utils/**/*.js",
      "!**/node_modules/**"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
