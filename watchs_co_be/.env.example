DB_HOST=localhost
DB_PORT=5432
DB_NAME=watchs_co
DB_USER=postgres
DB_PASSWORD=postgres

# Managed PostgreSQL (Supabase): prefer its pooler connection URL.
# Leave DATABASE_URL empty to use the individual DB_* values above.
DATABASE_URL=
DB_SSL=false
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

PORT=8000
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

GUEST_TOKEN_SECRET=change-me
COOKIE_SECRET=change-me
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Email delivery (log | file | smtp)
EMAIL_DELIVERY=log
EMAIL_OUTBOX_PATH=./outbox
EMAIL_FROM=Mechora <no-reply@mechora.local>
APP_BASE_URL=http://localhost:5173
EMAIL_VERIFY_PATH=/verify-email
PASSWORD_RESET_PATH=/password-reset

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_API_VERSION=2023-10-16
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
